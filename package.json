{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:dualite": "eslint --config eslint.dualite.config.js .",
    "tsc:dualite": "yarn tsc -p tsconfig.dualite.json",
    "preview": "vite preview",
    "fix:build": "node scripts/fix-build.js",
    "fix:build:yarn": "yarn cache clean --all && rimraf node_modules yarn.lock package-lock.json && yarn install && yarn add -D rollup @rollup/plugin-node-resolve @rollup/plugin-commonjs && yarn upgrade vite rollup && yarn build",
    "fix:build:npm": "npm cache clean --force && rimraf node_modules yarn.lock package-lock.json && npm install && npm install -D rollup @rollup/plugin-node-resolve @rollup/plugin-commonjs && npm update vite rollup && npm run build"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.9.0",
    "framer-motion": "^12.23.24",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.552.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/rollup-linux-x64-gnu": "^4.28.0",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "postcss": "^8.4.35",
    "rimraf": "^6.0.1",
    "rollup": "^4.28.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5"
  },
  "resolutions": {
    "@rollup/rollup-linux-x64-gnu": "^4.28.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
